{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SystemPulse",
  "version": "0.1.0",
  "identifier": "io.systempulse.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {"label":"main","title":"SystemPulse","width":1180,"height":800,"minWidth":360,"minHeight":480,"resizable":true,"visible":false},
      {"label":"widget","url":"index.html?widget=1","title":"SystemPulse Capsule","width":320,"height":112,"minWidth":280,"minHeight":96,"resizable":false,"decorations":false,"transparent":true,"shadow":false,"alwaysOnTop":true,"skipTaskbar":true,"visible":false}
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons-power/32x32.png",
      "icons-power/128x128.png",
      "icons-power/128x128@2x.png",
      "icons-power/icon.icns",
      "icons-power/icon.ico"
    ]
  }
}
